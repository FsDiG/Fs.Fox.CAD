<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows7.0</TargetFramework>
        <ACADVersion>2027</ACADVersion>
        <AutoCADManagedSdkVersion>2027</AutoCADManagedSdkVersion>
        <!-- This project targets net8.0 for the current protection toolchain; compile against ObjectARX2025 managed references because ObjectARX2027 managed assemblies target net10.0. -->
        <AutoCADManagedReferenceSdkVersion Condition="'$(AutoCADManagedReferenceSdkVersion)' == ''">2025</AutoCADManagedReferenceSdkVersion>
        <AssemblyName>Fs.Fox.AutoCad</AssemblyName>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <!--nuget package-->
    <PropertyGroup>
        <PackageId>IFox.CAD.ACAD2027</PackageId>
        <Title>Fs.Fox.CAD for AutoCAD 2027</Title>
        <Product>IFox.CAD.ACAD2027</Product>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <Description>面向 AutoCAD 2027 x64 产品链的 Fs.Fox.CAD 适配项目；当前按 .NET 8 构建，并使用 ObjectARX 2025 托管引用作为编译基线。</Description>
        <Copyright>FS Team</Copyright>
        <PackageReleaseNotes>增加CI流程支持，完善NuGet包信息</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
        <DebugType>none</DebugType>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <OutputPath>..\..\Build\AC_$(ACADVersion)_$(Configuration)\</OutputPath>
        <DocumentationFile>..\..\Build\AC_$(ACADVersion)_$(Configuration)\Fs.Fox.AutoCad.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <DebugType>none</DebugType>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <OutputPath>..\..\Build\AC_$(ACADVersion)_$(Configuration)\</OutputPath>
        <DocumentationFile>..\..\Build\AC_$(ACADVersion)_$(Configuration)\Fs.Fox.AutoCad.xml</DocumentationFile>
    </PropertyGroup>

    <!-- 条件编译符号 -->
    <PropertyGroup>
        <DefineConstants>$(Configuration);ACAD;AC_2027</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
	    <None Include="..\..\src\IFoxCAD.AutoCad\AutoCAD.props">
		    <Pack>True</Pack>
		    <PackagePath>\</PackagePath>
	    </None>
	    <None Include="..\..\src\IFoxCAD.AutoCad\copyToDigBuild.ps1">
		    <Pack>True</Pack>
		    <PackagePath>\</PackagePath>
	    </None>
	    <Compile Include="..\..\src\IFoxCAD.AutoCad\GlobalUsings.cs">
		    <Pack>True</Pack>
		    <PackagePath>\</PackagePath>
	    </Compile>
		<None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\readme.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <!-- Include Test DLL in NuGet package -->
        <None Include="..\..\Build\AC_$(ACADVersion)_$(Configuration)\TestAcad2027.dll" Condition="Exists('..\..\Build\AC_$(ACADVersion)_$(Configuration)\TestAcad2027.dll')">
            <Pack>True</Pack>
            <PackagePath>lib/net8.0-windows7.0/</PackagePath>
        </None>
    </ItemGroup>

    <!-- AutoCAD 2027 SDK 引用 -->
    <ItemGroup>
        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup>
        <FsFoxExternalAutoCADManagedReferencesProps>..\..\..\AutoCAD.ManagedReferences.props</FsFoxExternalAutoCADManagedReferencesProps>
        <AutoCADManagedSdkDir Condition="'$(AutoCADManagedSdkDir)' == '' and '$(AutoCADManagedReferenceSdkVersion)' != ''">$(FsLibsDir)SDK\ObjectARX$(AutoCADManagedReferenceSdkVersion)\inc\</AutoCADManagedSdkDir>
    </PropertyGroup>

    <ItemGroup Condition="!Exists('$(FsFoxExternalAutoCADManagedReferencesProps)') and '$(AutoCADManagedReferenceSdkVersion)' != ''">
        <Reference Include="AcCoreMgd">
            <HintPath>$(AutoCADManagedSdkDir)AcCoreMgd.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AcCui">
            <HintPath>$(AutoCADManagedSdkDir)AcCui.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AcDbMgd">
            <HintPath>$(AutoCADManagedSdkDir)AcDbMgd.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="acdbmgdbrep">
            <HintPath>$(AutoCADManagedSdkDir)acdbmgdbrep.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AcDx">
            <HintPath>$(AutoCADManagedSdkDir)AcDx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AcMgd">
            <HintPath>$(AutoCADManagedSdkDir)AcMgd.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AcMr">
            <HintPath>$(AutoCADManagedSdkDir)AcMr.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AcSeamless">
            <HintPath>$(AutoCADManagedSdkDir)AcSeamless.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AcTcMgd">
            <HintPath>$(AutoCADManagedSdkDir)AcTcMgd.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AcWindows">
            <HintPath>$(AutoCADManagedSdkDir)AcWindows.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AdUIMgd">
            <HintPath>$(AutoCADManagedSdkDir)AdUIMgd.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AdUiPalettes">
            <HintPath>$(AutoCADManagedSdkDir)AdUiPalettes.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="AdWindows">
            <HintPath>$(AutoCADManagedSdkDir)AdWindows.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Import Project="$(FsFoxExternalAutoCADManagedReferencesProps)" Condition="Exists('$(FsFoxExternalAutoCADManagedReferencesProps)')" />
    <Import Project="..\CADShared\CADShared.projitems" Label="Shared" />

</Project>


