<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48</TargetFrameworks>
        <ZWCADVersion>2022</ZWCADVersion>
        <AssemblyName>Fs.Fox.ZwCad</AssemblyName>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- 将因网络问题无法获取漏洞库的警告(NU1900)降级，避免在开启"将警告视为错误"时阻塞离线编译 -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    </PropertyGroup>
    
    <!--nuget package-->
    <PropertyGroup>
        <PackageId>IFox.CAD.ZCAD2022</PackageId>
        <Title>Fs.Fox.CAD for ZWCAD 2021-2024</Title>
        <Product>IFox.CAD.ZCAD2022</Product>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <Description>面向 ZWCAD 2021-2024 x64 API 代际和 .NET Framework 4.8 的 CAD 二次开发基础类库，使用 ZRXSDK 2022 x64 编译基线。源于 IFoxCAD，由 Fs 团队维护。</Description>
        <Copyright>FS Team</Copyright>
        <PackageReleaseNotes>增加CI流程支持，完善NuGet包信息</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
        <DebugType>none</DebugType>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <OutputPath>..\..\Build\ZW_$(ZWCADVersion)_$(Configuration)\</OutputPath>
        <DocumentationFile>..\..\Build\ZW_$(ZWCADVersion)_$(Configuration)\Fs.Fox.ZwCad.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
        <DebugType>none</DebugType>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <OutputPath>..\..\Build\ZW_$(ZWCADVersion)_$(Configuration)\</OutputPath>
        <DocumentationFile>..\..\Build\ZW_$(ZWCADVersion)_$(Configuration)\Fs.Fox.ZwCad.xml</DocumentationFile>
    </PropertyGroup>

    <!-- 条件编译符号 -->
    <PropertyGroup>
        <DefineConstants>$(Configuration);ZWCAD;ZW_2022</DefineConstants>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
	    <Compile Include="..\..\src\IFoxCAD.ZwCad\GlobalUsings.cs">
		    <Pack>True</Pack>
		    <PackagePath>\</PackagePath>
	    </Compile>
		<None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\readme.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <!-- Include Test DLL in NuGet package -->
        <None Include="..\..\Build\ZW_$(ZWCADVersion)_$(Configuration)\TestZcad2022.dll" Condition="Exists('..\..\Build\ZW_$(ZWCADVersion)_$(Configuration)\TestZcad2022.dll')">
            <Pack>True</Pack>
            <PackagePath>lib\net48\</PackagePath>
        </None>
    </ItemGroup>

    <!-- ZWCAD 2022 引用策略
         当 FsLibsDir 可用时使用本地 ZRX2022 x64 托管程序集（自托管构建机），NuGet 包仅版本声明。
         当 FsLibsDir 不可用时 NuGet 包提供编译时类型（GitHub 托管 runner），运行时由 CAD 宿主提供。 -->
    <PropertyGroup>
        <ZwCad2022NuGetExcludeAssets Condition="'$(FsLibsDir)' != ''">compile;runtime</ZwCad2022NuGetExcludeAssets>
        <ZwCad2022NuGetExcludeAssets Condition="'$(FsLibsDir)' == ''">runtime</ZwCad2022NuGetExcludeAssets>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="ZWCAD.NetApi" Version="20.22.0" ExcludeAssets="$(ZwCad2022NuGetExcludeAssets)" />
        <PackageReference Include="PolySharp" Version="1.16.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <Reference Include="Microsoft.CSharp" />
    </ItemGroup>
    <!-- 本地 ZRX2022 x64 SDK 引用：仅在 FsLibsDir 可用时生效 -->
    <ItemGroup Condition="'$(FsLibsDir)' != ''">
        <Reference Include="ZwDatabaseMgd">
            <HintPath>$(FsLibsDir)SDK\ZRX2022\lib-x64\ZwDatabaseMgd.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="ZwDatabaseMgdBrep">
            <HintPath>$(FsLibsDir)SDK\ZRX2022\lib-x64\ZwDatabaseMgdBrep.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="ZwManaged">
            <HintPath>$(FsLibsDir)SDK\ZRX2022\lib-x64\ZwManaged.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="ZcWindows">
            <HintPath>$(FsLibsDir)SDK\ZRX2022\lib-x64\ZcWindows.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="ZdWindows">
            <HintPath>$(FsLibsDir)SDK\ZRX2022\lib-x64\ZdWindows.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
    
    <Import Project="..\CADShared\CADShared.projitems" Label="Shared" />
</Project>

